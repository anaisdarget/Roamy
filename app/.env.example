# Local development defaults — no external account needed.
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock modes: the whole funnel works with these set to true.
AI_MOCK="true"
PAYMENT_MOCK="true"

# Stripe (only needed when PAYMENT_MOCK=false)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_ESSENTIAL=""
STRIPE_PRICE_ID_PREMIUM=""

# Anthropic (only needed when AI_MOCK=false)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Resend (optional — without it, emails are rendered and logged locally)
RESEND_API_KEY=""
EMAIL_FROM="Roamy <bonjour@roamy.travel>"
SUPPORT_EMAIL="bonjour@roamy.travel"

# Admin / session secrets. Change in production!
ADMIN_SECRET="dev-admin-secret-change-me"
SESSION_SECRET="dev-session-secret-change-me"

# Optional: override the public price constants (cents)
NEXT_PUBLIC_PLAN_ESSENTIAL_CENTS="900"
NEXT_PUBLIC_PLAN_PREMIUM_CENTS="1900"
